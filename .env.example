# Server-only. Never put this in the browser, a URL, or a log.
XAI_API_KEY=

# Shared passcode for the web UI.
READER_PASSCODE=

# HMAC secret for the session cookie. Use a long random string (openssl rand -base64 32).
READER_SESSION_SECRET=

# Bearer token for the story API (Authorization: Bearer ...).
READER_API_KEY=

# URL prefix. The reverse proxy must forward this prefix unchanged.
# Changing it requires a rebuild (Next bakes basePath at build time).
# Leave empty to serve the app at the host root.
BASE_PATH=/chinese

# Persistent stories and cached TTS audio. In Docker this is the volume mount.
DATA_DIR=/data

# Port the Next server listens on inside the container.
PORT=3010

# Host port published by docker compose. Defaults to 3010.
HOST_PORT=3010

# Forced-alignment sidecar. Docker Compose sets http://align:8000.
# Leave empty to keep xAI and transcript timings when the sidecar is not running.
ALIGN_URL=http://align:8000
